---
/**
 * Click-to-load YouTube embed. Without JavaScript the poster is a plain link
 * to YouTube; with JavaScript, clicking swaps in a youtube-nocookie iframe.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  poster: ImageMetadata;
  /** Accepted for API symmetry; the link text names the video, so the poster is decorative. */
  alt?: string;
  eager?: boolean;
  sizes?: string;
}
const { id, title, poster, eager = false, sizes = '(min-width: 64rem) 60vw, 100vw' } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}`;
---
<div class="video" data-video-id={id} data-video-title={title}>
  <a class="video__poster" href={watch} target="_blank" rel="noopener">
    <Picture
      src={poster}
      alt=""
      widths={[480, 800, 1200]}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="video__img"
    />
    <span class="video__play"><Icon name="play" /><span>Play video<span class="visually-hidden">: {title} (loads YouTube)</span></span></span>
  </a>
</div>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; background: #111; border-radius: var(--radius); overflow: hidden; }
  .video__poster { position: absolute; inset: 0; display: block; color: #fff; }
  .video :global(img), .video :global(iframe) { width: 100%; height: 100%; object-fit: cover; border: 0; }
  .video__play {
    position: absolute; left: var(--s-4); bottom: var(--s-4);
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: 44px; padding: 0 var(--s-4) 0 var(--s-3);
    background: rgba(21, 23, 28, 0.82); color: #fff;
    border-radius: 999px; font-size: 0.875rem; font-weight: 560;
    transition: background var(--dur) var(--ease);
  }
  .video__play :global(svg) { width: 1.1rem; height: 1.1rem; }
  .video__poster:hover .video__play, .video__poster:focus-visible .video__play { background: var(--accent-ink); }
  .video__poster:focus-visible { outline-offset: -4px; outline-color: #fff; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.video[data-video-id]').forEach((box) => {
    const link = box.querySelector('a');
    link?.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.videoId}?autoplay=1&rel=0`;
      iframe.title = box.dataset.videoTitle ?? 'YouTube video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
