---
import { getImage } from 'astro:assets';
import reelPoster from '../assets/reel-poster.jpg';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { person, hero, projects, moreWork, experience, moreExperience, about } from '../data/content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const [feature, ...rest] = projects;
const poster = await getImage({ src: reelPoster, width: 1280, format: 'webp' });
const nav = [
  { href: '#experience', label: 'Experience' },
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
];
---
<Base
  title={`${person.name} — Software Engineer`}
  description="Chinamay Kasareddy is a software engineer who builds simulations, multiplayer systems and full-stack web apps, has led teams of 6–7 developers to MVP, and has taught full-stack development."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="brand" href="#top">
        <span class="brand__mark" aria-hidden="true">CK</span>
        <span class="brand__name">{person.name}</span><span class="visually-hidden">, back to top</span>
      </a>
      <nav aria-label="Primary">
        <ul role="list" class="nav">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="#contact" class="nav__cta">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="hero__name" data-enter style="--i:0">{person.name} <span>· {person.role}</span></p>
        <h1 id="hero-title" class="hero__title" data-enter style="--i:1">{hero.headline}</h1>
        <p class="hero__intro" data-enter style="--i:2">{hero.intro}</p>
        <div class="hero__actions" data-enter style="--i:3">
          <a class="btn btn--solid" href="#work"><Icon name="arrow" />See my work</a>
          <a class="btn btn--ghost" href="#contact">Get in touch</a>
        </div>
        <dl class="hero__proof" data-enter style="--i:4">
          {hero.proof.map((p) => (
            <div><dt>{p.label}</dt><dd>{p.value}</dd></div>
          ))}
        </dl>
      </div>
      <figure class="reel" data-enter style="--i:2">
        <video
          controls
          preload="none"
          playsinline
          poster={poster.src}
          width="1920"
          height="1080"
          aria-describedby="reel-caption"
        >
          <source src={`${base}media/showreel.mp4`} type="video/mp4" />
          <a href={`${base}media/showreel.mp4`}>Download the showreel (MP4)</a>
        </video>
        <figcaption id="reel-caption"><strong>Showreel, 90 seconds.</strong> Web apps, computer vision, mobile apps and games in one cut. Sound on.</figcaption>
      </figure>
    </section>

    <section class="section" id="experience" aria-labelledby="exp-title">
      <div class="wrap">
        <div class="section__head" data-reveal>
          <p class="eyebrow">Experience</p>
          <h2 id="exp-title" class="section__title">Building, leading and teaching since 2020</h2>
        </div>
        <ol role="list" class="roles">
          {experience.map((r, i) => (
            <li class="role" data-reveal style={`--i:${i % 3}`}>
              <p class="role__dates">{r.dates}</p>
              <div class="role__head">
                <h3 class="role__title">{r.title}</h3>
                <p class="role__org">{r.org}</p>
              </div>
              <ul class="role__points">
                {r.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </li>
          ))}
        </ol>
        <details class="disclosure more-exp" data-reveal>
          <summary>Independent ventures and earlier roles: Dusk Games Interactive, an Etsy digital-asset shop, RippleMatch, APATICS</summary>
          <ol role="list" class="roles roles--compact">
            {moreExperience.map((r) => (
              <li class="role">
                <p class="role__dates">{r.dates}</p>
                <div class="role__head">
                  <h3 class="role__title">{r.title}</h3>
                  <p class="role__org">{r.org}</p>
                </div>
                <ul class="role__points">
                  {r.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </details>
      </div>
    </section>

    <section class="section work" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <div class="section__head section__head--row" data-reveal>
          <p class="eyebrow">Selected work</p>
          <h2 id="work-title" class="section__title">Three projects, three kinds of problem</h2>
        </div>

        <ProjectCard project={feature} feature index={0} />

        <div class="work__pair">
          {rest.map((p, i) => <ProjectCard project={p} index={i + 1} />)}
        </div>

        <details class="disclosure more" data-reveal>
          <summary>More Work</summary>
          <ul role="list" class="more__list">
            {moreWork.map((m) => (
              <li class="more__item">
                <VideoEmbed id={m.video.id} title={m.video.title} poster={m.image} sizes="(min-width: 64rem) 18rem, 100vw" />
                <div>
                  <h3 class="more__title">{m.name}</h3>
                  <p class="more__context">{m.context}</p>
                  <p class="more__summary">{m.summary}</p>
                  <p class="more__links">
                    {m.links.map((l) => (
                      <a class="text-link" href={l.href} target="_blank" rel="noopener">{l.label}<span class="visually-hidden">: {m.name}</span></a>
                    ))}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="wrap about">
        <div class="about__intro" data-reveal>
          <p class="eyebrow">About</p>
          <h2 id="about-title" class="section__title">Mathematics first, then the code</h2>
          {about.paragraphs.map((t) => <p>{t}</p>)}
        </div>

        <div class="about__side" data-reveal style="--i:1">
          <h3 class="minor-title">Education</h3>
          <ul role="list" class="edu">
            {about.education.map((e) => (
              <li>
                <p><strong>{e.degree}</strong></p>
                <p>{e.school} · {e.dates}</p>
                <p class="muted">{e.detail}</p>
              </li>
            ))}
          </ul>
          <h3 class="minor-title">Credentials</h3>
          <ul role="list" class="creds">
            {about.credentials.map((c) => <li>{c}</li>)}
          </ul>
        </div>

        <div class="about__caps">
          <h3 class="minor-title">What I work with, and where I’ve used it</h3>
          <dl class="caps">
            {about.capabilities.map((c, i) => (
              <div class="cap" data-reveal style={`--i:${i}`}>
                <dt>{c.area}</dt>
                <dd>
                  <p>{c.evidence}</p>
                  <p class="muted">{c.tools}</p>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="section contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap contact__inner">
        <div data-reveal>
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title" class="contact__title">Have a problem worth solving? Let’s talk.</h2>
          <p class="section__lede">To discuss a role, a project or a collaboration, LinkedIn is the best way to reach me.</p>
        </div>
        <div class="contact__actions" data-reveal style="--i:1">
          <a class="btn btn--solid" href={person.links.linkedin} target="_blank" rel="noopener">Message me on LinkedIn<Icon name="external" /></a>
          <ul role="list" class="contact__links">
            <li><a class="text-link" href={person.links.github} target="_blank" rel="noopener">GitHub<Icon name="external" /></a></li>
            <li><a class="text-link" href={person.links.youtube} target="_blank" rel="noopener">YouTube<Icon name="external" /></a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <p>© {new Date().getFullYear()} {person.name}</p>
      <a class="text-link" href="#top">Back to top</a>
    </div>
  </footer>
</Base>

<style>
  /* header */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header { transition: box-shadow 300ms var(--ease-out), border-color 300ms var(--ease-out); }
  .site-header.is-scrolled { box-shadow: 0 10px 30px -22px rgba(21, 23, 28, 0.5); }
  .nav a { position: relative; }
  .nav a[aria-current]:not(.nav__cta) { color: var(--ink); }
  .nav a:not(.nav__cta)::after { content: ''; position: absolute; left: var(--s-3); right: var(--s-3); bottom: 8px; height: 1.5px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 420ms var(--ease-out); }
  .nav a[aria-current]:not(.nav__cta)::after { transform: none; }
  .reel video { transition: box-shadow 500ms var(--ease-out); box-shadow: 0 30px 60px -40px rgba(21,23,28,.55); }
  .more__item :global(img) { transition: transform 900ms var(--ease-out); }
  .more__item:hover :global(img) { transform: scale(1.03); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; gap: var(--s-3); text-decoration: none; font-weight: 600; letter-spacing: -0.01em; min-height: 44px; }
  .brand__mark {
    display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%;
    background: var(--ink); color: var(--paper); font-family: var(--font-serif); font-size: 1rem; font-weight: 400; letter-spacing: 0.02em;
  }
  .nav { display: flex; align-items: center; gap: var(--s-1); margin: 0; }
  .nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s-3);
    text-decoration: none; font-size: 0.9375rem; font-weight: 500; color: var(--ink-2); border-radius: 999px;
  }
  .nav a:hover { color: var(--ink); background: var(--accent-wash); }
  .nav .nav__cta { color: var(--paper); background: var(--ink); padding: 0 var(--s-4); margin-left: var(--s-2); min-height: 38px; }
  .nav .nav__cta:hover { background: var(--accent-ink); color: #fff; }

  @media (max-width: 47.99rem) {
    .brand__name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .site-header__inner { gap: var(--s-2); }
    .nav { gap: 0; }
    .nav a { padding: 0 var(--s-2); font-size: 0.875rem; }
    .nav .nav__cta { padding: 0 var(--s-3); margin-left: var(--s-1); }
  }
  @media (max-width: 30rem) {
    .brand__mark { width: 1.75rem; height: 1.75rem; font-size: 0.875rem; }
    .nav a { padding: 0 7px; font-size: 0.8125rem; }
    .nav .nav__cta { padding: 0 var(--s-3); }
    .hero { padding-block: var(--s-6); gap: var(--s-5); }
    .hero__intro { font-size: var(--step-0); }
  }
  @media (max-width: 22.5rem) {
    .nav a { padding: 0 5px; font-size: 0.78rem; }
    .nav .nav__cta { padding: 0 9px; }
  }

  main:focus { outline: none; }

  /* hero */
  .hero {
    display: grid; gap: var(--s-6);
    padding-block: var(--s-7) var(--s-7);
  }
  .hero__name { font-weight: 600; font-size: var(--step-0); }
  .hero__name span { font-weight: 400; color: var(--ink-3); }
  .hero__title {
    font-family: var(--font-serif); font-weight: 400;
    font-size: var(--step-4); line-height: 1.02; letter-spacing: -0.02em;
    margin-top: var(--s-4); max-width: 18ch; text-wrap: balance;
  }
  .hero__intro { margin-top: var(--s-5); font-size: var(--step-1); color: var(--ink-2); max-width: 36rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .hero__proof { display: grid; gap: 0 var(--s-5); margin-top: var(--s-6); border-top: 1px solid var(--ink); }
  @media (min-width: 40rem) { .hero__proof { grid-template-columns: repeat(3, 1fr); } }
  .reel { display: grid; gap: var(--s-3); align-self: center; }
  .reel video { width: 100%; height: auto; aspect-ratio: 16 / 9; background: #15171c; border-radius: var(--radius); }
  .reel figcaption { font-size: var(--step--1); color: var(--ink-3); }
  .reel figcaption strong { color: var(--ink); }
  .hero__proof > div { padding: var(--s-3) 0; border-bottom: 1px solid var(--line); display: grid; gap: 2px; }
  .hero__proof dt { font-size: var(--step--1); color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  .hero__proof dd { font-weight: 500; }
  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--s-7); padding-block: var(--s-7); align-items: center; }
  }

  /* work */
  .work { padding-top: var(--s-7); }
  @media (min-width: 64rem) {
    .section__head--row { grid-template-columns: 1fr; }
  }
  .work__pair {
    display: grid; gap: var(--s-7);
    margin-top: var(--s-8); padding-top: var(--s-7); border-top: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .work__pair { grid-template-columns: 1fr 1fr; gap: var(--s-6); }
  }
  @media (min-width: 64rem) { .work__pair { gap: var(--s-8); } }

  .more { margin-top: var(--s-8); }
  .more > summary { font-size: var(--step-0); }
  .more__list { display: grid; gap: var(--s-6); padding: var(--s-4) 0 var(--s-5); margin: 0; }
  .more__item { display: grid; gap: var(--s-4); align-content: start; }
  .more__item :global(img) { border-radius: var(--radius); aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .more__title { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-2); line-height: 1.2; }
  .more__context { font-size: var(--step--1); color: var(--ink-3); }
  .more__summary { margin-top: var(--s-2); color: var(--ink-2); font-size: 0.9375rem; }
  .more__links { display: flex; flex-wrap: wrap; gap: 0 var(--s-5); }
  @media (min-width: 48rem) {
    .more__list { grid-template-columns: repeat(3, 1fr); }
  }

  /* experience */
  .roles { margin: 0; border-top: 1px solid var(--ink); }
  .role { display: grid; gap: var(--s-2); padding: var(--s-5) 0; border-bottom: 1px solid var(--line); }
  .role__dates { font-size: var(--step--1); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .role__title { font-size: var(--step-1); font-weight: 620; line-height: 1.3; }
  .role__org { color: var(--ink-2); }
  .role__points { padding-left: 1.1rem; display: grid; gap: var(--s-1); color: var(--ink-2); font-size: 0.9375rem; }
  .role__points li::marker { color: var(--line-strong); }
  @media (min-width: 64rem) {
    .role { grid-template-columns: 10rem minmax(0, 4fr) minmax(0, 7fr); gap: var(--s-6); align-items: baseline; }
  }

  .more-exp { margin-top: var(--s-5); }
  .roles--compact { border-top: 0; }
  .roles--compact .role:last-child { border-bottom: 0; }

  /* about */
  .about { display: grid; gap: var(--s-7); }
  .about__intro { display: grid; gap: var(--s-4); max-width: 40rem; }
  .about__intro .section__title { margin-bottom: var(--s-2); }
  .about__intro p:not(.eyebrow) { color: var(--ink-2); font-size: var(--step-1); line-height: 1.6; }
  .minor-title { font-size: var(--step--1); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--s-3); }
  .about__side { display: grid; align-content: start; }
  .edu { display: grid; gap: var(--s-4); margin: 0 0 var(--s-6); }
  .edu li { display: grid; gap: 2px; font-size: 0.9375rem; }
  .creds { display: grid; gap: var(--s-2); margin: 0; font-size: 0.9375rem; }
  .muted { color: var(--ink-3); font-size: var(--step--1); }
  .about__caps { grid-column: 1 / -1; }
  .caps { display: grid; border-top: 1px solid var(--ink); }
  .cap { display: grid; gap: var(--s-1); padding: var(--s-4) 0; border-bottom: 1px solid var(--line); }
  .cap dt { font-weight: 620; }
  .cap dd { display: grid; gap: var(--s-1); color: var(--ink-2); font-size: 0.9375rem; }
  @media (min-width: 48rem) {
    .caps { grid-template-columns: 1fr 1fr; column-gap: var(--s-6); }
  }
  @media (min-width: 64rem) {
    .about { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); column-gap: var(--s-8); }
    .caps { grid-template-columns: repeat(4, 1fr); }
  }

  /* contact */
  .contact { background: var(--ink); color: var(--paper); border-top: 0; }
  .contact .eyebrow { color: #f0b48f; }
  .contact .section__lede { color: #c9c5bc; margin-top: var(--s-4); }
  .contact__inner { display: grid; gap: var(--s-6); }
  .contact__title { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-4); line-height: 1.05; letter-spacing: -0.02em; margin-top: var(--s-3); max-width: 16ch; }
  .contact__actions { display: grid; gap: var(--s-3); align-content: end; justify-items: start; }
  .contact .btn--solid { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .contact .btn--solid:hover { background: #f0b48f; border-color: #f0b48f; color: var(--ink); }
  .contact .btn--ghost { color: var(--paper); border-color: #6b6f78; }
  .contact .btn--ghost:hover { background: var(--paper); color: var(--ink); }
  .contact__links { display: flex; flex-wrap: wrap; gap: 0 var(--s-5); margin: var(--s-2) 0 0; }
  .contact .text-link { text-decoration-color: #6b6f78; }
  .contact .text-link:hover { color: #f0b48f; }
  .contact :focus-visible { outline-color: #9ec1ff; }
  @media (min-width: 64rem) {
    .contact__inner { grid-template-columns: 7fr 5fr; gap: var(--s-8); align-items: end; }
  }

  .site-footer { background: var(--ink); color: #a9a59c; border-top: 1px solid #2c2f36; font-size: var(--step--1); }
  .site-footer__inner { display: flex; justify-content: space-between; align-items: center; min-height: 4rem; }
  .site-footer .text-link { font-size: var(--step--1); text-decoration-color: #555; }
  .site-footer .text-link:hover { color: #f0b48f; }
  .site-footer :focus-visible { outline-color: #9ec1ff; }
</style>
