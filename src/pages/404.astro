---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page not found — Chinamay Kasareddy" description="This page doesn’t exist." noindex>
  <main class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This page doesn’t exist.</h1>
    <p><a class="btn btn--solid" href={base}>Go to Chinamay Kasareddy’s portfolio</a></p>
  </main>
</Base>
<style>
  .nf { min-height: 100vh; display: grid; align-content: center; gap: var(--s-5); }
  h1 { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-4); line-height: 1.05; }
</style>
